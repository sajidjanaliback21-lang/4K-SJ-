rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // Security removed as per user request to use simple password only
      return true;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Free Movies Collection
    match /free_movies/{movieId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Free Series Collection
    match /free_series/{seriesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Events Collection
    match /live_events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Favorites Collection
    match /favorites/{favoriteId} {
      allow read, write: if true;
    }

    // User Profiles Collection
    match /user_profiles/{username} {
      allow read, write: if true;
    }

    // FIFA Channels Collection
    match /fifa_channels/{channelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Activity Collection
    match /user_activity/{username} {
      allow read, write: if true;
    }

    // Playback Logs Collection
    match /playback_logs/{logId} {
      allow read, write: if true;
    }

    // Playback Stats Collection
    match /playback_stats/{statId} {
      allow read, write: if true;
    }

    // Resellers Collection
    match /resellers/{resellerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Media Requests Collection
    match /media_requests/{requestId} {
      allow read, write: if true;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
