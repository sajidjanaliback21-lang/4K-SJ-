{
  "entities": {
    "settings": {
      "title": "Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "psl_live_url_urdu": {
          "type": "string",
          "description": "The current PSL Live Urdu stream URL"
        },
        "psl_live_url_english": {
          "type": "string",
          "description": "The current PSL Live English stream URL"
        },
        "ipl_live_url": {
          "type": "string",
          "description": "The current IPL Live stream URL"
        },
        "psl_enabled": { "type": "boolean" },
        "ipl_enabled": { "type": "boolean" },
        "free_movies_enabled": { "type": "boolean" },
        "free_series_enabled": { "type": "boolean" },
        "live_events_enabled": { "type": "boolean" },
        "psl_title": { "type": "string" },
        "ipl_title": { "type": "string" },
        "free_movies_title": { "type": "string" },
        "free_series_title": { "type": "string" },
        "live_events_title": { "type": "string" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["psl_live_url_urdu", "psl_live_url_english"]
    },
    "free_movies": {
      "title": "Free Movies",
      "description": "Custom movies added for free access",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "poster_url": { "type": "string" },
        "play_url": { "type": "string" },
        "download_url": { "type": "string" },
        "password": { "type": "string", "description": "Optional password to lock access to this movie" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "poster_url", "play_url"]
    },
    "free_series": {
      "title": "Free Series",
      "description": "Custom series added for free access",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "poster_url": { "type": "string" },
        "play_url": { "type": "string" },
        "download_url": { "type": "string" },
        "password": { "type": "string", "description": "Optional password to lock access to this series" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "poster_url", "play_url"]
    },
    "live_events": {
      "title": "Live Events",
      "description": "Custom live events added for streaming live channels",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "poster_url": { "type": "string" },
        "channels": {
          "type": "array",
          "description": "An array of channels, each holding a custom name, play_url, and optional is_embed setting"
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "poster_url", "channels"]
    },
    "favorites": {
      "title": "Favorites",
      "description": "User specific favorite movies, series, or live TV channels sync'd across any device",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "itemId": { "type": "string" },
        "type": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["username", "itemId", "type"]
    },
    "user_profiles": {
      "title": "User Profiles",
      "description": "User-specific profiles containing custom or selected avatars",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "avatarId": { "type": "string" },
        "customAvatar": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username"]
    },
    "fifa_channels": {
      "title": "FIFA Channels",
      "description": "FIFA World Cup 2026 channels managed by admin",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "play_url": { "type": "string" },
        "is_mpd": { "type": "boolean" },
        "is_embed": { "type": "boolean" },
        "status": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "play_url"]
    },
    "user_activity": {
      "title": "User Activity",
      "description": "Records user logins and metadata about their sessions",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "loginCount": { "type": "number" },
        "firstActive": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "lastLogin"]
    },
    "playback_logs": {
      "title": "Playback Logs",
      "description": "Records of individual media clicks and playback events",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "channelName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "itemId", "itemName", "category", "timestamp"]
    },
    "playback_stats": {
      "title": "Playback Stats",
      "description": "Aggregated statistics for played media items",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "category": { "type": "string" },
        "totalPlays": { "type": "number" },
        "users": { "type": "object", "description": "Map of username to boolean for tracking unique users" },
        "lastPlayed": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "itemName", "category", "totalPlays"]
    },
    "resellers": {
      "title": "Resellers",
      "description": "Information about Resellers for custom branding",
      "type": "object",
      "properties": {
        "subdomain": { "type": "string", "description": "The subdomain or domain keyword to match" },
        "brand_name": { "type": "string" },
        "tagline": { "type": "string" },
        "whatsapp_number": { "type": "string" },
        "whatsapp_group_link": { "type": "string" },
        "logo_url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subdomain", "brand_name"]
    }
  },
  "firestore": {
    "/resellers/{resellerId}": {
      "schema": "resellers",
      "description": "Collection of resellers configurations"
    },
    "/settings/psl": {
      "schema": "settings",
      "description": "The document containing the PSL Live stream URL"
    },
    "/settings/ipl": {
      "schema": "settings",
      "description": "The document containing the IPL Live stream URL"
    },
    "/settings/app": {
      "schema": "settings",
      "description": "Global application feature toggles and titles"
    },
    "/free_movies/{movieId}": {
      "schema": "free_movies",
      "description": "Collection of free movies"
    },
    "/free_series/{seriesId}": {
      "schema": "free_series",
      "description": "Collection of free series"
    },
    "/live_events/{id}": {
      "schema": "live_events",
      "description": "Collection of live events with multiple channels"
    },
    "/favorites/{favoriteId}": {
      "schema": "favorites",
      "description": "Collection of user-specific favorite items"
    },
    "/user_profiles/{username}": {
      "schema": "user_profiles",
      "description": "User profiles with avatars"
    },
    "/fifa_channels/{channelId}": {
      "schema": "fifa_channels",
      "description": "Collection of FIFA World Cup 2026 channels"
    },
    "/user_activity/{username}": {
      "schema": "user_activity",
      "description": "Collection of user activity logs"
    },
    "/playback_logs/{logId}": {
      "schema": "playback_logs",
      "description": "Collection of single playback logs"
    },
    "/playback_stats/{statId}": {
      "schema": "playback_stats",
      "description": "Aggregated clicks/stats for videos"
    }
  }
}
